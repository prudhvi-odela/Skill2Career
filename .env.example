# Skill2Career Application Configuration (MongoDB Edition)
PROJECT_NAME="Skill2Career"
JWT_SECRET="replace-with-a-secure-random-secret-key-for-production"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Connection (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="skill2career"

# Optional: Google Gemini API Key for Enhanced LLM Explanations
# If empty, built-in deterministic expert heuristic generator is used automatically
GEMINI_API_KEY=""

# Frontend API Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"
