# Skill2Career Application Configuration
PROJECT_NAME="Skill2Career"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite for local dev, PostgreSQL for staging/production)
# SQLite: sqlite:///./skill2career.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/skill2career
DATABASE_URL="sqlite:///./skill2career.db"

# Optional: Google Gemini API Key for Enhanced LLM Explanations
# If empty, built-in deterministic expert heuristic generator is used automatically
GEMINI_API_KEY=""

# Frontend API Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"
